# Venice API (OpenAI-compatible)
NE_LLM_PROVIDER=openai
NE_LLM_BASE_URL=https://api.venice.ai/api/v1
NE_LLM_REASONING_EFFORT=none
NE_LLM_REQUEST_TIMEOUT_SECONDS=90
NE_LLM_API_KEY=

# A killed watcher can reclaim its checkpointed document after this interval.
NE_DOCUMENT_LEASE_SECONDS=180

# Cost/quality routing by extraction stage
NE_LLM_MODEL=zai-org-glm-5-2
NE_SEG_MODEL=mistral-small-3-2-24b-instruct
# Cheap, constrained registry selection for unresolved focal subjects.
NE_SCOPE_MODEL=mistral-small-3-2-24b-instruct
# Segmentation is required even for curated chapter ranges: selection says
# which text matters, not that every selected chapter contains only one event.
NE_ENABLE_SEGMENTATION=true
NE_EXTRACT_MODEL=zai-org-glm-5-2
# Strong model used only when two or more same-scope episodes can be reviewed
# together in document chronology.
NE_RECONCILE_MODEL=zai-org-glm-5-2
NE_CLASSIFY_MODEL=deepseek-v4-flash-0731-fast
NE_LINK_MODEL=deepseek-v4-flash-0731
# Cross-chunk/document linking supersedes the expensive all-pairs pass inside
# each individual chunk.
NE_ENABLE_CHUNK_LINKING=false
NE_STAGE_CONCURRENCY=3

# Conservative pairwise-link prefilter
NE_LINK_NEIGHBOR_WINDOW=1
NE_LINK_MAX_YEAR_GAP=25
NE_LINK_MIN_LEXICAL_OVERLAP=0.2
NE_CROSS_LINK_MAX_PAIRS=20

# Evidence floors: unsupported labels stay visible but do not become hard
# classification/scope partitions.
NE_TAU_CLASS=0.5
NE_TAU_ROLE=0.5
NE_TAU_SCOPE=0.6
